    "@types/react-native": "^0.72.8",
    "@types/react-native-razorpay": "^2.2.6",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "metro": "0.72.3",
    "metro-config": "0.72.3",
    "metro-core": "0.72.3",
    "metro-resolver": "0.72.3",
    "react-async-hook": "3.6.1"
